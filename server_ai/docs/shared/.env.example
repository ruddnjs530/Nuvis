AI_RECOMMENDATION_BASE_URL=http://YOUR_GPU_SERVER_IP:9000
AI_STT_BASE_URL=http://YOUR_GPU_SERVER_IP:9001
# 메인 백엔드 서버의 기본 접속 주소를 입력하세요 (방 정보 동기화용)
BACKEND_BASE_URL=http://YOUR_BACKEND_SERVER_IP:포트

# [보안 화이트리스트] AI 서버에 접근을 허락할 메인 백엔드 서버의 IP 목록 (콤마로 구분)
# 이 곳에 명시되지 않은 외부 IP가 AI 데이터통신 포트(9000, 9001)로 직접 접속을 시도하면
# AI 서버가 응답하지 않고 강력하게 403 Forbidden 에러로 튕겨냅니다.
ALLOWED_BACKEND_IPS=127.0.0.1,192.168.X.X
