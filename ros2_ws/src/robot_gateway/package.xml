<?xml version="1.0"?>
<package format="3">
  <name>robot_gateway</name>
  <version>0.1.0</version>
  <description>gRPC gateway package bridging external clients to ROS2 robot control interfaces.</description>
  <maintainer email="team@example.com">B110 Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>robot_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-grpcio</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
